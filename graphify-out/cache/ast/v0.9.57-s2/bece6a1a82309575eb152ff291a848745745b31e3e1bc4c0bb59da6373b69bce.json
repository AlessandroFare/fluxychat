{"nodes": [{"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": "agent/skills/hyperframes-audio/SKILL.md", "source_location": "L1", "frontmatter": {"description": "Use when audio already placed in a HyperFrames composition needs to be mixed: a music bed that fights a voiceover (voiceover carve), effects on a track (EQ, compressor, limiter, gate, saturation, delay, reverb, chorus, phaser, bitcrush), or automation envelopes drawn on a track&#x27;s volume or any effect parameter. Don&#x27;t use for sourcing or generating audio \u2014 finding BGM, SFX, or making a voiceover is `/media-use`. Don&#x27;t use for clip timing or track layout, which is `/hyperframes-core`.\\n"}}, {"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_hyperframes_audio", "label": "HyperFrames Audio", "file_type": "document", "node_kind": "heading", "source_file": "agent/skills/hyperframes-audio/SKILL.md", "source_location": "L4"}, {"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_how_it_fits_together", "label": "How it fits together", "file_type": "document", "node_kind": "heading", "source_file": "agent/skills/hyperframes-audio/SKILL.md", "source_location": "L32"}, {"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_first_work_out_what_is_wrong", "label": "First, work out what is wrong", "file_type": "document", "node_kind": "heading", "source_file": "agent/skills/hyperframes-audio/SKILL.md", "source_location": "L107"}, {"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_start_from_the_symptom", "label": "Start from the symptom", "file_type": "document", "node_kind": "heading", "source_file": "agent/skills/hyperframes-audio/SKILL.md", "source_location": "L132"}, {"id": "$graphify-root$_agent_skills_hyperframes_audio_skill_reach_for_a_family_by_the_problem_not_the_name", "label": "Reach for a family by the problem, not the name", "file_type": "document", "node_kind"
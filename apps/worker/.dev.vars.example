# USAGE_COST_PER_1K_MESSAGES_USD=0.50
# USAGE_COST_PER_AGENT_INVOKE_USD=0.02
# USAGE_COST_PER_GB_STORAGE_USD=0.10
# USAGE_COST_PLATFORM_BASE_USD=0

# --- Cloudflare Stream (live angles + replay) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_CODE=

# --- Matrix appservice (#16) — token stored per-bridge in D1 after migration 0180 ---
# Configure Bearer token in Synapse + dashboard /bridges/matrix

# --- OTel / Langfuse preset (#9) ---
# Configure via POST /otel/configs/langfuse or /agents/observability (no extra env required)

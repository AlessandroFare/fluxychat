# Copy to `.dev.vars` in this folder (Wrangler loads it for `wrangler dev`).
# Do not commit real secrets. Lines are KEY=value (no quotes needed for simple values).

# --- CORS / auth (local dashboard) ---
# Local dev: explicit loopback origins. Production must list every dashboard
# origin it serves (do NOT set "*"). To opt into wildcard CORS for a
# self-hosted dev only, use ALLOWED_ORIGINS=*.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to "false" only for local experiments (keep true in shared/staging/prod).
REQUIRE_ADMIN_AUTH=true
# IP rate-limit source (audit M-4). CF-Connecting-IP is always trusted. The
# client-controlled X-Forwarded-For header is only used when this is exactly
# "true" — set it ONLY if the Worker sits behind a proxy that rewrites/strips
# inbound XFF. Leaving it unset/false prevents rate-limit bypass via spoofed XFF.
# TRUST_FORWARDED_FOR=false
# API key hashing salt (audit S-11). Generate 32+ random bytes, base64-encode.
# Without this, a weak default is used and a warning is logged.
# API_KEY_HASH_SALT=base64-32-bytes-here

# --- JWT key rotation (audit S-31) ---
# When rotating jwt_secret in D1 project_secrets, set the previous secret here
# and schedule its expiration. After JWT_SECRET_PREVIOUS_EXPIRES_AT (ISO
# timestamp), tokens signed with the previous secret will be rejected, even if
# still configured. Leave unset to accept the previous secret indefinitely
# (legacy behaviour — a warning is logged on every use).
# JWT_SECRET_PREVIOUS=...old-jwt-secret-base64...
# JWT_SECRET_PREVIOUS_EXPIRES_AT=2026-12-31T00:00:00Z

# --- Agent tool allow-list (audit A-5) ---
# Comma-separated global list of tool names the LLM is permitted to invoke.
# - If set to a non-empty list (e.g. "search,calculator"): only those tools
#   reach the LLM. Every other tool name is stripped at extraction time
#   and logged at WARN level.
# - If set to empty string (""): all tools are stripped (fail-closed).
#   Use this as an emergency kill switch.
# - If the env var is absent entirely: the global gate is skipped and
#   the per-bot (bots.allowed_tools) and per-project default
#   (projects.default_allowed_tools) allow-lists apply instead. This is
#   the legacy behaviour and is the default for existing deployments.
#
# Note: tool names are trimmed of whitespace before comparison. A single
# space character "" in the list is treated as a literal tool name (and
# will never match a real tool), not as a separator.
# AGENT_TOOL_ALLOWLIST=search,calculator

# --- Self-host fallback (audit S-14) ---
# In self-host mode (HOSTED_MULTI_TENANT unset/false), the worker previously
# fell back to DEFAULT_PROJECT_ID for any request without a valid API key.
# That is a footgun. Set this to "true" only if you intentionally want the
# legacy single-tenant behaviour. Leave unset / "false" in shared/staging/prod.
# ALLOW_LEGACY_DEFAULT_PROJECT=true

# --- Hosted SaaS (multi-tenant cloud) ---
# Local dev tip: after `pnpm provision:bootstrap`, copy BOTH fc_... key AND project UUID
# from scripts/.provision-secrets.env into dashboard .env.local AND FLUXY_PLATFORM_PROJECT_ID here.
# Mismatched key vs project id → Cloud connect "forbidden" and onboarding create project fails.
# For simplest local dev you can leave HOSTED_MULTI_TENANT unset/false.
# HOSTED_MULTI_TENANT=true
# FLUXY_PLATFORM_PROJECT_ID=<uuid-from-provision-bootstrap>
# Tenants cannot use Worker AI_API_KEY; they must set project LLM credentials (or set for internal demos):
# ALLOW_WORKER_LLM_FALLBACK=false
# PLATFORM_BOOTSTRAP_SECRET=<random-32+-chars-for-one-time-setup>
# ALLOW_PLATFORM_BOOTSTRAP=true
# One-time / periodic: POST /platform/sanitize-plans (pnpm sanitize:plans from repo root)
# SANITIZE_ALLOW_MANUAL_PAID_TIERS=true   # keep starter/pro without Stripe when sanitizing

# --- Stripe (billing) — leave empty until you run Stripe E2E ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Feature flags (P12-J) — optional Flagship app; falls back to env vars below ---
# FLAGSHIP_APP_ID=          # wrangler [[flagship]] app_id
# FEATURE_VOICE_MESSAGES=true
# FEATURE_REPLY_SUGGESTIONS=true
# FEATURE_RECONNECT_BACKOFF_FLUXY=false   # SDK: 1s/8s backoff when true via GET /client/feature-flags

# --- Browser Run (cost control) ---
# Binding exists in wrangler.toml but quickAction() is off unless opt-in:
# BROWSER_ENABLED=true

# --- Scheduled jobs (P12-L) ---
# Local dev: disable workflow schedules and use legacy Worker cron (uncomment [triggers] in wrangler.toml)
# WORKFLOW_SCHEDULES_ENABLED=false

# --- AI (agents, optional auto room summary) ---
# Prefer Cloudflare AI Gateway (P12-I) — routes chat, Whisper, embeddings with caching/rate limits.
# Set AI_GATEWAY_URL OR both AI_GATEWAY_ACCOUNT_ID + AI_GATEWAY_ID (provider segment defaults to openai).
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=fluxychat
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openai
# AI_GATEWAY_TOKEN=          # Cloudflare API token (or CLOUDFLARE_API_TOKEN)
# AI_GATEWAY_PROVIDER_KEY=     # upstream OpenAI key (cf-aig-authorization); falls back to AI_API_KEY
# AI_GATEWAY_CACHE_TTL=3600    # optional response cache TTL (seconds)
# AI_GATEWAY_PROVIDER=openai   # gateway path segment (openai, anthropic, workers-ai, …)
# AI_GATEWAY_ENABLED=false     # kill switch — force legacy AI_BASE_URL even if gateway vars are set
# Legacy direct OpenAI-compatible fallback when gateway is unset:
# Local dev default: OpenCode Zen + DeepSeek Flash (free tier)
AI_BASE_URL=https://opencode.ai/zen
AI_API_KEY=
AI_MODEL=deepseek-v4-flash-free
ANTHROPIC_API_KEY=
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo  # override default whisper-1

# Dedicated transcription provider (optional; falls back to AI_BASE_URL / AI_API_KEY).
# Use this when your main LLM provider (e.g. OpenCode Zen) does not support audio transcription,
# and you want a separate provider (e.g. Groq) just for voice messages.
# AI_TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# AI_TRANSCRIBE_API_KEY=gsk_your_groq_key
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Dedicated image generation provider (optional; falls back to AI_BASE_URL / AI_API_KEY).
# Use this when your main LLM provider does not support image generation.
# AI_IMAGE_BASE_URL=
# AI_IMAGE_API_KEY=
# AI_IMAGE_MODEL=dall-e-3
# AI_IMAGE_GENERATION_ENABLED=false

# Pollinations.ai — free, no API key required (set provider to "pollinations")
# AI_IMAGE_PROVIDER=pollinations
# AI_IMAGE_MODEL=flux  # also: flux-realism, sdxl, playground
# AI_IMAGE_GENERATION_ENABLED=true

# Dedicated embeddings provider (optional; falls back to AI_BASE_URL / AI_API_KEY).
# Use this when your main LLM provider (e.g. Groq) does not support embeddings,
# and you want a separate provider (e.g. OpenCode Zen) just for vector generation.
# AI_EMBEDDINGS_BASE_URL=
# AI_EMBEDDINGS_API_KEY=

# Optional per-provider keys / base URLs (see apps/worker/src/lib/llm-providers.js)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# ZENCODE_API_KEY=
# ZENCODE_BASE_URL=https://your-zencode-host/v1
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# Brave Search — required for live [web-search] / [deep-research] in agent rooms
# BRAVE_SEARCH_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- SSRF allowlist (audit S-15) ---
# Comma-separated hostnames or suffix domains that bypass the SSRF blocklist.
# Use for self-hosted webhooks that point at internal services.
# ALLOWED_SSRF_HOSTS=internal.acme.com,*.staging.acme.com

# --- Webhook signing secrets at rest ---
# Base64-encoded 32-byte AES key. Generate once and store in Wrangler secrets.
# In production, this MUST be set; setting ALLOW_PLAINTEXT_WEBHOOK_SECRETS
# is forbidden (audit S-25).
# WEBHOOK_SECRET_ENCRYPTION_KEY=...base64(32bytes)...
# Only set this to "true" in local dev (audit S-25).
# ALLOW_PLAINTEXT_WEBHOOK_SECRETS=true

# --- Optional: dispatch operational alerts ---
# ALERT_DISPATCH_WEBHOOK_URL=

# --- Quotas & pricing assumptions (defaults match README) ---
# QUOTAS_ENABLED=true
# QUOTA_MESSAGES_PER_MONTH=200000
# QUOTA_AGENT_INVOKES_PER_MONTH=5000
# QUOTA_WEBHOOK_DELIVERIES_PER_MONTH=50000
# COST_MESSAGES_PER_MILLION=1
# COST_REQUESTS_PER_MILLION=0.2
# PRICE_PER_MILLION_MESSAGES=1
# MIN_GROSS_MARGIN=0.3

# --- Optional automations ---
# BUILTIN_MODERATION_ENABLED=true
# BUILTIN_MODERATION_BLOCKED_SUBSTRINGS=spam,scam
# AUTO_ROOM_SUMMARY_ENABLED=true
# AUTO_ROOM_SUMMARY_EVERY_N=50
# AUTO_ROOM_SUMMARY_COOLDOWN_MINUTES=120

# --- Public demo room (GET|POST /demo/session, dashboard /demo) ---
# DEMO_ROOM_ID=public-demo-room
# DEMO_API_KEY=fc_your_project_key
# DEMO_USER_ID=demo-guest
# DEMO_AGENT_HANDLE=@assistant
# DEMO_AGENT_NAME=FluxyBot
# DEMO_TOKEN_TTL_SECONDS=1800
# DEMO_READ_ONLY=false
# DEMO_ENABLED=true
# DEMO_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# TURNSTILE_SECRET_KEY=          # wrangler secret; requires POST /demo/session from UI
# DEMO_ALLOW_GET_WITHOUT_TURNSTILE=true   # local dev only when Turnstile secret is set
# RATE_LIMIT_DEMO_SESSIONS_PER_MINUTE=20
# RATE_LIMIT_AUTH_TOKEN_PER_MINUTE=30     # POST /auth/token per IP + api key
# RATE_LIMIT_WS_CONNECTIONS_PER_MINUTE=30   # per-IP WS upgrades (/ws/room/*); 0 = disabled
# RATE_LIMIT_PUBLIC_WS_CONNECTIONS_PER_MINUTE=60  # public rooms only; falls back to WS limit above
# PUBLIC_GUEST_ENABLED=true
# PUBLIC_GUEST_READ_ONLY=true
# PUBLIC_GUEST_TOKEN_TTL_SECONDS=3600
# PUBLIC_GUEST_ALLOWED_ORIGINS=https://app.example.com
# PUBLIC_GUEST_TURNSTILE_REQUIRED=false
# FCM_SERVER_KEY=...   # legacy FCM HTTP API for mobile push (P10-SB7)
# SMS_OTP_ENABLED=true
# SENT_DM_OTP_TEMPLATE_NAME=authentication
# RATE_LIMIT_SMS_OTP_PER_MINUTE=5
# SMS_OTP_DEBUG_CODE=false   # dev only: return code in API response
# PUSH_ENABLED=true    # optional flag when using non-FCM bridge later
# AI_TRANSLATE_MODEL=openai/gpt-4o-mini
# RATE_LIMIT_PUBLIC_GUEST_PER_MINUTE=30
# RATE_LIMIT_WS_MESSAGES_PER_MINUTE=60      # per-user WS message sends (Room DO)

# --- Voice / LiveKit (PG-ZB-10 — SFU runs off Workers) ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://livekit.example.com

# --- MCP marketplace audit webhook (PG-ZB-7 — CI posts signed results) ---
# MARKETPLACE_AUDIT_HMAC_SECRET=random-32-chars
# GitHub secrets: WORKER_AUDIT_WEBHOOK_URL=https://worker.example.com/internal/marketplace/audit-result
# WORKER_AUDIT_HMAC_SECRET=<same as MARKETPLACE_AUDIT_HMAC_SECRET>

# --- Security contact (used in /.well-known/security.txt) ---
# SECURITY_CONTACT_EMAIL=security@fluxychat.com
# Point this to a DEDICATED, MONITORED inbox before going public.
# It will receive third-party vulnerability reports; an autoresponder
# that issues CVE-style ticket IDs and pages a human is the
# minimum bar. See RUNBOOK_DEPLOY_ROLLBACK.md §8 for rotation.

# --- Offline SMS via Sent.dm (optional built-in — see docs/cookbook/offline-notify-sent-dm.md) ---
# OFFLINE_SMS_ENABLED=true
# SENT_DM_API_KEY=
# SENT_DM_PROFILE_ID=
# OFFLINE_SMS_TEMPLATE_NAME=chat_notify
# OFFLINE_SMS_CHANNELS=sms,whatsapp
# OFFLINE_SMS_IDLE_MINUTES=5
# OFFLINE_SMS_PER_USER_PER_HOUR=6
# SENT_DM_WEBHOOK_SECRET=whsec_...   # verify POST /integrations/sent/webhook
# PUBLIC_APP_URL=https://app.example.com   # room_url + media_url (relative /attachments/*) in Sent template params
# OFFLINE_SMS_MEDIA_ENABLED=true   # default on; set false to omit media_url from offline notify (P13-T3)
# Members opt in via PATCH /rooms/:id/members/me/preferences → preferences.smsE164 + smsOptIn
# Sent template chat_notify: add media variables media_url, media_name, media_type (WhatsApp/MMS)

# --- Custom domains (P12-G) ---
# WORKER_PLATFORM_HOSTS=api.fluxychat.com,localhost
# Comma-separated hostnames that use API-key/default project routing (not white-label lookup)

# --- Agent task queue (P13-T4) ---
# AGENT_QUEUE_SLA_MINUTES=15
# AGENT_QUEUE_AUTO_INBOUND=true   # enqueue on inbound SMS/WA (requires TELCO_INBOUND_ENABLED)

# --- Dev-only provision endpoint (POST /dev/provision) ---
# Enables the local first-message script (pnpm run first-message).
# Mounted only when ALLOW_DEV_PROVISION=true AND NODE_ENV is development|test.
# NEVER set this in any non-local environment — it lets anyone mint a
# project API key with no auth.
NODE_ENV=development
ALLOW_DEV_PROVISION=true
# --- /dev/provision ---

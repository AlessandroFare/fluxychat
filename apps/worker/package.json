{
  "name": "@fluxychat/worker",
  "version": "0.1.0",
  "description": "Fluxychat Cloudflare Worker – WebSocket, Durable Objects, D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/worker.js",
    "deploy": "wrangler deploy src/worker.js",
    "test": "vitest run --exclude '**/worker.e2e.test.js' --exclude '**/push-vapid.e2e.test.js'",
    "test:e2e": "vitest run src/worker.e2e.test.js src/lib/push-vapid.e2e.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "drill:tenant-recovery": "node scripts/tenant-recovery-drill.mjs",
    "perf:workload-check": "node scripts/perf-workload-check.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "db:export-baseline": "node scripts/export-d1-baseline.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@xmldom/xmldom": "^0.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.5",
    "wrangler": "^4.92.0"
  },
  "dependencies": {
    "@fluxychat/protocol": "workspace:*",
    "remend": "^1.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "xml-c14n": "^0.0.6"
  }
}

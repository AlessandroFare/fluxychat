# Generate: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_that_is_at_least_32_characters_long

# Worker secrets (same key/secret)
# LIVEKIT_URL=ws://localhost:7880          # local dev
# LIVEKIT_URL=wss://livekit.yourdomain.com # production (TLS required)

{
  "name": "@fluxy-chat/sdk",
  "version": "0.6.7",
  "description": "FluxyChat JavaScript/TypeScript SDK — WebSocket rooms, REST messages, FluxyChatClient, agents, and vertical SDKs",
  "license": "MIT",
  "author": "Fluxychat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroFare/fluxychat.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/AlessandroFare/fluxychat/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/AlessandroFare/fluxychat/issues"
  },
  "keywords": [
    "chat",
    "websocket",
    "realtime",
    "cloudflare",
    "fluxychat"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./edu": {
      "types": "./dist/edu.d.ts",
      "import": "./dist/edu.js",
      "default": "./dist/edu.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js",
      "default": "./dist/health.js"
    },
    "./event": {
      "types": "./dist/event.d.ts",
      "import": "./dist/event.js",
      "default": "./dist/event.js"
    },
    "./finance": {
      "types": "./dist/finance.d.ts",
      "import": "./dist/finance.js",
      "default": "./dist/finance.js"
    },
    "./continuity": {
      "types": "./dist/continuity.d.ts",
      "import": "./dist/continuity.js",
      "default": "./dist/continuity.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.ts",
      "import": "./dist/worker-runtime.js",
      "default": "./dist/worker-runtime.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./verticals": {
      "types": "./dist/verticals.d.ts",
      "import": "./dist/verticals.js",
      "default": "./dist/verticals.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./yjs": {
      "types": "./dist/yjs.d.ts",
      "import": "./dist/yjs.js",
      "default": "./dist/yjs.js"
    },
    "./testing": {
      "types": "./dist/testing-utils.d.ts",
      "import": "./dist/testing-utils.js",
      "default": "./dist/testing-utils.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @fluxy-chat/protocol build",
    "build": "pnpm exec tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && node ../../scripts/verify-publish-manifest.mjs",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm exec vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.5",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "@fluxy-chat/protocol": "workspace:*",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-string": "^4.0.0",
    "partysocket": "1.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remend": "^1.0.0",
    "unified": "^11.0.5",
    "yjs": "^13.6.31"
  }
}


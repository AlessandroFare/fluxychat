{
  "name": "@fluxy-chat/config",
  "version": "0.1.0",
  "description": "Type-safe fluxy.config.ts authoring for FluxyChat rooms, authz, and message middleware",
  "author": "Fluxychat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroFare/fluxychat.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/AlessandroFare/fluxychat/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/AlessandroFare/fluxychat/issues"
  },
  "keywords": ["chat", "config", "middleware", "authz", "fluxychat"],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "test": "pnpm exec vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/verify-publish-manifest.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}

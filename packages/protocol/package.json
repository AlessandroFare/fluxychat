{
    "name":  "@fluxy-chat/protocol",
    "version":  "0.1.7",
    "description":  "Shared FluxyChat wire protocol — WebSocket event types and validators for SDKs and the worker",
    "license":  "MIT",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "errors",
                  "protocol-events.json",
                  "README.md"
              ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/AlessandroFare/fluxychat.git",
                       "directory":  "packages/protocol"
                   },
    "homepage":  "https://github.com/AlessandroFare/fluxychat/tree/main/packages/protocol#readme",
    "bugs":  {
                 "url":  "https://github.com/AlessandroFare/fluxychat/issues"
             },
    "keywords":  [
                     "chat",
                     "websocket",
                     "protocol",
                     "fluxychat"
                 ],
    "author":  "Fluxychat",
    "scripts":  {
                    "generate:errors":  "node scripts/generate-error-codes.mjs",
                    "check:errors":  "node scripts/generate-error-codes.mjs --check",
                    "build":  "pnpm exec tsc -p tsconfig.json",
                    "test":  "node scripts/generate-error-codes.mjs --check && vitest run",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "prepublishOnly":  "pnpm run build && node ../../scripts/verify-publish-manifest.mjs"
                },
    "devDependencies":  {
                            "typescript":  "^7.0.2",
                            "vite":  "^8.0.16",
                            "vitest":  "^4.1.11"
                        },
    "publishConfig":  {
                          "access":  "public"
                      }
}

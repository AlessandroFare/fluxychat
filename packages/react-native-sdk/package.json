{
    "name":  "@fluxy-chat/react-native-sdk",
    "version":  "1.0.0",
    "description":  "React Native SDK for FluxyChat - realtime chat infrastructure",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "sideEffects":  false,
    "publishConfig":  {
                          "access":  "public"
                      },
    "engines":  {
                    "node":  "\u003e=18.0.0"
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "dev":  "tsc -w -p tsconfig.json",
                    "prepublishOnly":  "pnpm run build",
                    "test":  "vitest run",
                    "lint":  "eslint src/",
                    "typecheck":  "tsc --noEmit"
                },
    "keywords":  [
                     "chat",
                     "realtime",
                     "messaging",
                     "react-native",
                     "fluxychat"
                 ],
    "author":  "Fluxychat",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/AlessandroFare/fluxychat.git",
                       "directory":  "packages/react-native-sdk"
                   },
    "homepage":  "https://github.com/AlessandroFare/fluxychat/tree/main/packages/react-native-sdk#readme",
    "bugs":  {
                 "url":  "https://github.com/AlessandroFare/fluxychat/issues"
             },
    "peerDependencies":  {
                             "react":  "\u003e=18.0.0",
                             "react-native":  "\u003e=0.72.0"
                         },
    "devDependencies":  {
                            "@types/react":  "^18.2.0",
                            "@types/react-native":  "^0.72.0",
                            "typescript":  "^5.3.0",
                            "vite":  "^8.0.16",
                            "vitest":  "^4.1.5"
                        },
    "dependencies":  {
                         "@fluxy-chat/protocol":  "workspace:*"
                     },
    "files":  [
                  "dist/",
                  "README.md",
                  "LICENSE"
              ]
}

